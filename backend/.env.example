# Copia este archivo como .env, en esta misma carpeta (backend), y pon tu usuario y contraseña de MySQL.
# El backend lo lee al arrancar. No subas el .env al repositorio: .gitignore ya lo excluye.
DB_USER=root
DB_PASSWORD=

# Correo para enviar la carta responsiva (opcional; sin MAIL_HOST el envío marca error)
# Ej. Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587 y una contraseña de aplicación (sin espacios) en MAIL_PASSWORD
# MAIL_FROM es opcional: el nombre que verá el cliente (ej. Montacargas Obregon); vacío = la cuenta de MAIL_USER
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
